# Entertwine Chatbot SDK - Environment Configuration

# Required: Redis connection URL
# Example: redis://localhost:6379/0 or redis://:password@host:port/0
REDIS_URL=redis://redis:6379/0

# Required: Azure Search Service
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-search-service-key
AZURE_SEARCH_INDEX=medichat-index

# Required: Azure OpenAI Configuration
ENDPOINT_URL=https://your-openai-instance.openai.azure.com
DEPLOYMENT_NAME=your-deployment-name
AZURE_OPENAI_API_KEY=your-openai-api-key

# Required: Azure Translation Service
AZURE_TEXT_TRANSLATION_APIKEY=your-translation-api-key
AZURE_TEXT_TRANSLATION_REGION=eastus

# Optional: Microsoft Teams Bot Configuration
# Only needed if using Teams integration
MICROSOFT_APP_ID=your-teams-app-id
MICROSOFT_APP_PASSWORD=your-teams-app-password
MICROSOFT_TENANT_ID=your-tenant-id
